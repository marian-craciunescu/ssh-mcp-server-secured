
# Load with node --env-file=.env index.js --sse

SSE_PORT=3001
SSH_LOG_LEVEL=DEBUG

SSH_FILTER_MODE=mixed
SSH_ALLOW_SUDO=false

SSH_WHITELIST=show, show running-config interface, show running-config | section, show running-config | include, ping -c , ls -lha, traceroute, terminal length 0, set cli screen-length 0
SSH_BLACKLIST=show running-config, show running-config all, conf t, configure terminal, reload, rm, shutdown,ping

# --- pager handling ---
SSH_DISABLE_PAGER=true
SSH_MAX_PAGER_PAGES=1000
# Override the disable-pager command per device type (DEVICETYPE uppercased):
# SSH_DISABLE_PAGER_CMD_CISCO=terminal length 0
# SSH_DISABLE_PAGER_CMD_JUNIPER=set cli screen-length 0
# SSH_DISABLE_PAGER_CMD_FORTINET=
# Override pager detection / advance key (advanced):
# SSH_PAGER_REGEX=(?:--\s*more\s*--|---\(more[^)]*\)---|<-+\s*more\s*-+>)
# SSH_PAGER_ADVANCE_KEY=" "

SSH_AUDIT_ENABLED=true
SSH_AUDIT_DIR=./audit
SSH_IDLE_TIMEOUT=120

# Resolution priority: explicit args > profile env > connectionId env
PROFILE_ROUTERS_USER=user
PROFILE_ROUTERS_PASSWORD=pass
# PROFILE_ROUTERS_ENABLE_PASSWORD=enable123
PROFILE_ROUTERS_DEVICE_TYPE=juniper
PROFILE_ROUTERS_PORT=22
PROFILE_ROUTERS_WHITELIST=show ospf neighbor, show version, show interfaces terse, show route summary, show chassis hardware, set cli screen-length 0, set cli screen-width 0
PROFILE_ROUTERS_BLACKLIST=show configuration, configure, edit, delete, commit, rollback, request system, conf t, configure terminal
PROFILE_ROUTERS_DISABLE_PAGER=true


# PROFILE_ROUTERS_JUMP_COMMAND=telnet lh
# Fallback list for ssh_run_with_jump - tried in order until one reaches the nested prompt.
# JSON array or comma-separated. Takes priority over the singular JUMP_COMMAND above.
# PROFILE_ROUTERS_JUMP_COMMANDS=["telnet lh", "telnet lh 601"]
# PROFILE_ROUTERS_PRESET=topex
# PROFILE_ROUTERS_SSH_OPTIONS={"KexAlgorithms":"+diffie-hellman-group-exchange-sha1","HostKeyAlgorithms":"+ssh-rsa"}


; PROFILE_ROUTERS_WHITELIST=show ospf neigh,show version,show ip interface brief
; PROFILE_ROUTERS_BLACKLIST=show running config,conf t,configure terminal
PROFILE_ROUTERS_DISABLE_PAGER=true
SSH_MAX_PAGER_PAGES=1000